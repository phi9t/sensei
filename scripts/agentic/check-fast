#!/usr/bin/env bash
set -euo pipefail

repo="$(git rev-parse --show-toplevel)"
cd "$repo"

source "$repo/scripts/agentic/lib.sh"

commands=(
  "npm run format:check"
  "npm run lint"
  "npm run typecheck"
  "npm test"
)

if dry_run_requested "${1:-}"; then
  print_plan "${commands[@]}"
  exit 0
fi

run_shell_cmd "npm run format:check"
run_shell_cmd "npm run lint"
run_shell_cmd "npm run typecheck"
run_shell_cmd "npm test"
