#!/usr/bin/env bash
set -euo pipefail

repo="$(git rev-parse --show-toplevel)"
cd "$repo"

source "$repo/scripts/agentic/lib.sh"

commands=(
  "npm run verify"
  "git diff --check"
)

if dry_run_requested "${1:-}"; then
  print_plan "${commands[@]}"
  exit 0
fi

run_shell_cmd "npm run verify"
run_shell_cmd "git diff --check"
