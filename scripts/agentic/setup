#!/usr/bin/env bash
set -euo pipefail

repo="$(git rev-parse --show-toplevel)"
cd "$repo"

source "$repo/scripts/agentic/lib.sh"

commands=("npm ci")

if dry_run_requested "${1:-}"; then
  print_plan "${commands[@]}"
  exit 0
fi

mkdir -p .agentic/logs
run_cmd npm ci 2>&1 | tee ".agentic/logs/setup-$(date -u '+%Y%m%dT%H%M%SZ').log"
