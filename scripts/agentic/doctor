#!/usr/bin/env bash
set -euo pipefail

repo="$(git rev-parse --show-toplevel)"
cd "$repo"

source "$repo/scripts/agentic/lib.sh"

failures=0

check_ok() {
  printf '[ok] %s\n' "$1"
}

check_fail() {
  printf '[missing] %s\n' "$1" >&2
  failures=$((failures + 1))
}

check_optional() {
  printf '[optional] %s\n' "$1"
}

if dry_run_requested "${1:-}"; then
  print_plan \
    "git rev-parse --show-toplevel" \
    "kata whoami" \
    "kata list --agent" \
    "roborev version" \
    "roborev status" \
    "bash -n scripts/agentic/*" \
    "git check-ignore .agentic .roborev .worktrees"
  exit 0
fi

printf 'repo=%s\n' "$repo"
printf 'branch=%s\n' "$(git branch --show-current)"
printf 'head=%s\n' "$(git rev-parse HEAD)"
printf 'git_dir=%s\n' "$(cd "$(git rev-parse --git-dir)" && pwd -P)"
printf 'git_common_dir=%s\n' "$(cd "$(git rev-parse --git-common-dir)" && pwd -P)"

base_branch="$(config_value base_branch)"
if [[ "$(git branch --show-current)" == "$base_branch" ]]; then
  check_fail "current branch is base branch $base_branch"
else
  check_ok "current branch is not base branch $base_branch"
fi

if command -v kata >/dev/null 2>&1; then
  check_ok "kata binary: $(command -v kata)"
  kata version || check_fail "kata version command failed"
  kata whoami || check_fail "kata actor unresolved"
  kata list --agent >/dev/null || check_fail "kata list failed"
else
  check_fail "kata binary"
fi

if [[ -f .kata.toml ]]; then
  check_ok ".kata.toml exists"
else
  check_fail ".kata.toml exists"
fi

if command -v roborev >/dev/null 2>&1; then
  check_ok "roborev binary: $(command -v roborev)"
  roborev version || check_fail "roborev version command failed"
  if roborev status >/dev/null 2>&1; then
    check_ok "roborev daemon reachable"
  else
    check_fail "roborev daemon reachable"
  fi
else
  check_fail "roborev binary"
fi

if [[ -f .roborev.toml ]]; then
  check_ok ".roborev.toml exists"
else
  check_fail ".roborev.toml exists"
fi

hook_path="$(git rev-parse --git-path hooks/post-commit)"
printf 'post_commit_hook=%s\n' "$hook_path"
if [[ -x "$hook_path" ]] && grep -q 'roborev post-commit' "$hook_path"; then
  check_ok "post-commit hook invokes roborev"
else
  check_fail "post-commit hook invokes roborev"
fi

for dir in .worktrees .agentic .roborev; do
  if git check-ignore -q "$dir" || git check-ignore -q "$dir/"; then
    check_ok "$dir is ignored"
  else
    check_fail "$dir is ignored"
  fi
done

for script in scripts/agentic/setup scripts/agentic/check-fast scripts/agentic/check-full scripts/agentic/review-branch scripts/agentic/new-worktree scripts/agentic/task-start scripts/agentic/task-finish; do
  if [[ -x "$script" ]]; then
    check_ok "$script executable"
  else
    check_fail "$script executable"
  fi
  bash -n "$script" || check_fail "$script shell syntax"
done

marker_pattern="$(printf '%s\n' 'T''BD' 'TO''DO' 'REVIEW''_AGENT' 'PRIMARY''_AGENT' | paste -sd '|' -)"
if command -v rg >/dev/null 2>&1; then
  placeholder_hits="$(rg -n "\b($marker_pattern)\b" AGENTS.md CLAUDE.md agentic.toml .roborev.toml docs/agentic-engineering scripts/agentic || true)"
else
  placeholder_hits="$(grep -R -n -E "\b($marker_pattern)\b" AGENTS.md CLAUDE.md agentic.toml .roborev.toml docs/agentic-engineering scripts/agentic || true)"
fi

if [[ -n "$placeholder_hits" ]]; then
  printf '%s\n' "$placeholder_hits" >&2
  check_fail "no unresolved placeholders in agentic files"
else
  check_ok "no unresolved placeholders in agentic files"
fi

if command -v bwrap >/dev/null 2>&1; then
  check_optional "bwrap available: $(bwrap --version)"
else
  check_optional "bwrap unavailable; untrusted execution fails closed"
fi

if command -v agentsview >/dev/null 2>&1; then
  check_optional "agentsview available: $(agentsview --version 2>&1 | head -1)"
else
  check_optional "agentsview unavailable"
fi

for command in "npm ci" "npm run format:check" "npm run lint" "npm run typecheck" "npm test" "npm run build" "npm run verify"; do
  check_ok "repository command declared: $command"
done

if [[ "$failures" -gt 0 ]]; then
  printf 'doctor failed with %s missing required checks.\n' "$failures" >&2
  exit 1
fi

printf 'doctor passed.\n'
