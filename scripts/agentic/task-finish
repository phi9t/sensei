#!/usr/bin/env bash
set -euo pipefail

repo="$(git rev-parse --show-toplevel)"
cd "$repo"

source "$repo/scripts/agentic/lib.sh"

usage() {
  cat <<'USAGE'
Usage: scripts/agentic/task-finish <kata-ref> --message "<completion>" --test "<command>"

Runs completion verification, closes the Kata task with commit and test evidence,
and preserves the branch/worktree for human review.
USAGE
}

if [[ "${1:-}" == "--help" || $# -lt 5 ]]; then
  usage
  [[ "${1:-}" == "--help" ]] && exit 0
  exit 2
fi

kata_ref="$1"
kata_cli_ref="$(normalize_kata_ref "$kata_ref")"
shift
message=""
test_command=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --message)
      message="${2:-}"
      shift 2
      ;;
    --test)
      test_command="${2:-}"
      shift 2
      ;;
    *)
      printf 'Unknown argument: %s\n' "$1" >&2
      usage
      exit 2
      ;;
  esac
done

if [[ -z "$message" || -z "$test_command" ]]; then
  printf 'Both --message and --test are required.\n' >&2
  usage
  exit 2
fi

ensure_not_base_branch
refuse_when_owned_by_other "$kata_cli_ref"

run_cmd kata show "$kata_cli_ref" --agent
run_shell_cmd "$test_command"
run_cmd scripts/agentic/check-full
run_cmd scripts/agentic/review-branch

head_sha="$(git rev-parse HEAD)"
manifest_path="$(run_manifest_path "$kata_cli_ref")"
write_run_manifest "$kata_cli_ref" "$manifest_path" "$(timestamp_utc)" "$head_sha"

run_cmd kata close "$kata_cli_ref" --done \
  --message "$message" \
  --commit "$head_sha" \
  --test "$test_command"

printf 'handoff=branch preserved for human review\n'
printf 'branch=%s\n' "$(git branch --show-current)"
printf 'head=%s\n' "$head_sha"
printf 'manifest=%s\n' "$manifest_path"
