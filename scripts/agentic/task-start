#!/usr/bin/env bash
set -euo pipefail

repo="$(git rev-parse --show-toplevel)"
cd "$repo"

source "$repo/scripts/agentic/lib.sh"

if [[ "${1:-}" == "--help" || $# -ne 1 ]]; then
  cat <<'USAGE'
Usage: scripts/agentic/task-start <kata-ref>

Shows, claims when unowned, and records a local run manifest for a Kata task.
USAGE
  [[ "${1:-}" == "--help" ]] && exit 0
  exit 2
fi

kata_ref="$1"
kata_cli_ref="$(normalize_kata_ref "$kata_ref")"
refuse_when_owned_by_other "$kata_cli_ref"

owner="$(issue_owner "$kata_cli_ref")"
if [[ -z "$owner" ]]; then
  run_cmd kata claim "$kata_cli_ref"
fi

manifest_path="$(run_manifest_path "$kata_cli_ref")"
write_run_manifest "$kata_cli_ref" "$manifest_path"

run_cmd kata meta set "$kata_cli_ref" work.attention ok
run_cmd kata meta set "$kata_cli_ref" work.branch "$(git branch --show-current)"
run_cmd kata show "$kata_cli_ref" --agent

printf 'manifest=%s\n' "$manifest_path"
printf 'specs=%s\n' "docs/superpowers/specs/"
printf 'plans=%s\n' "docs/superpowers/plans/"
